<Project Sdk="Microsoft.NET.Sdk">
  <!-- Builds the game's TrackLibrary outside Unity (see Program.cs). If Unity isn't installed
       where UnityData says below, pass your install's Editor/Data folder as a property, as in
       Art/Tracks/README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS0436</NoWarn>
    <UnityData Condition="'$(UnityData)' == ''">E:\Program Files\Unity Hub\Editor\6000.3.27f1\Editor\Data</UnityData>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\..\Assets\Scripts\TrackLibrary.cs" Link="Game\TrackLibrary.cs" />
    <Compile Include="..\..\..\Assets\Scripts\TrackCourse.cs" Link="Game\TrackCourse.cs" />
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(UnityData)\Managed\UnityEngine\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
